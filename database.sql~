-- -- 3. Relationship Definitions (Foreign Keys)
-- ---------------------------------
-- Mendefinisikan relasi antar tabel.

-- Relasi One-to-One: seller_profiles dengan users
ALTER TABLE seller_profiles ADD FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE;

-- Relasi Many-to-One: menu_items dengan seller_profiles
ALTER TABLE menu_items ADD FOREIGN KEY (seller_profile_id) REFERENCES seller_profiles(id) ON DELETE CASCADE;

-- Relasi Many-to-One: daily_listings dengan menu_items
ALTER TABLE daily_listings ADD FOREIGN KEY (menu_item_id) REFERENCES menu_items(id) ON DELETE CASCADE;

-- Relasi Many-to-One: orders dengan users (customer)
ALTER TABLE orders ADD FOREIGN KEY (customer_id) REFERENCES users(id) ON DELETE SET NULL;

-- Relasi Many-to-One: orders dengan seller_profiles (seller)
ALTER TABLE orders ADD FOREIGN KEY (seller_profile_id) REFERENCES seller_profiles(id) ON DELETE SET NULL;

-- Relasi Many-to-One: order_items dengan orders
ALTER TABLE order_items ADD FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE;

-- Relasi Many-to-One: order_items dengan daily_listings
ALTER TABLE order_items ADD FOREIGN KEY (listing_id) REFERENCES daily_listings(id) ON DELETE RESTRICT;

-- Relasi Many-to-One: payments dengan orders
ALTER TABLE payments ADD FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE;

-- Relasi Many-to-One: seller_reviews dengan users (customer)
ALTER TABLE seller_reviews ADD FOREIGN KEY (customer_id) REFERENCES users(id) ON DELETE CASCADE;

-- Relasi Many-to-One: seller_reviews dengan seller_profiles
ALTER TABLE seller_reviews ADD FOREIGN KEY (seller_profile_id) REFERENCES seller_profiles(id) ON DELETE CASCADE;

-- Relasi Many-to-One: menu_item_reviews dengan users (customer)
ALTER TABLE menu_item_reviews ADD FOREIGN KEY (customer_id) REFERENCES users(id) ON DELETE CASCADE;

-- Relasi Many-to-One: menu_item_reviews dengan menu_items
ALTER TABLE menu_item_reviews ADD FOREIGN KEY (menu_item_id) REFERENCES menu_items(id) ON DELETE CASCADE;

-- Relasi One-to-One: carts dengan users (customer)
ALTER TABLE carts ADD FOREIGN KEY (customer_id) REFERENCES users(id) ON DELETE CASCADE;

-- Relasi Many-to-One: cart_items dengan carts
ALTER TABLE cart_items ADD FOREIGN KEY (cart_id) REFERENCES carts(id) ON DELETE CASCADE;

-- Relasi Many-to-One: cart_items dengan daily_listings
ALTER TABLE cart_items ADD FOREIGN KEY (listing_id) REFERENCES daily_listings(id) ON DELETE CASCADE;

-- Relasi Many-to-One: withdrawal_requests dengan seller_profiles
ALTER TABLE withdrawal_requests ADD FOREIGN KEY (seller_id) REFERENCES seller_profiles(id) ON DELETE CASCADE;

-- Relasi Many-to-One: withdrawal_requests dengan users (admin)
ALTER TABLE withdrawal_requests ADD FOREIGN KEY (processed_by_id) REFERENCES users(id) ON DELETE SET NULL;


