-- Dihapus oleh AI: Saya sengaja tidak menyertakan perintah 'DROP' untuk menghindari penghapusan data yang tidak disengaja.
-- Jika Anda perlu menjalankan ulang skrip ini pada database yang sudah ada, Anda dapat menambahkan perintah 'DROP' secara manual,
-- misalnya: DROP TABLE IF EXISTS users CASCADE;

-- ---------------------------------
-- -- 1. Enum Definitions
-- ---------------------------------
-- Membuat tipe data kustom (enum) untuk memastikan konsistensi data.

CREATE TYPE user_role AS ENUM (
  'customer',
  'seller',
  'admin'
);

CREATE TYPE user_status AS ENUM (
  'active',
  'inactive',
  'suspended'
);

CREATE TYPE listing_status AS ENUM (
  'available',
  'sold_out'
);

CREATE TYPE order_status AS ENUM (
  'pending_payment',
  'paid',
  'preparing',
  'ready_for_pickup',
  'completed',
  'cancelled'
);

CREATE TYPE payment_status AS ENUM (
  'pending',
  'success',
  'failed',
  'expired'
);

CREATE TYPE withdrawal_status AS ENUM (
    'PENDING',
    'APPROVED',
    'REJECTED'
);


-- ---------------------------------
-- -- 2. Table Definitions
-- ---------------------------------

-- Tabel untuk menyimpan data pengguna
CREATE TABLE users (
                       id VARCHAR(36) PRIMARY KEY,
                       username VARCHAR(100) NOT NULL UNIQUE,
                       full_name VARCHAR(255) NOT NULL,
                       email VARCHAR(255) NOT NULL UNIQUE,
                       password_hash VARCHAR(255) NOT NULL,
                       phone_number VARCHAR(20) UNIQUE,
                       role user_role NOT NULL,
                       status user_status NOT NULL DEFAULT 'active',
                       suspended_until TIMESTAMPTZ, -- Digunakan oleh admin untuk menetapkan periode suspensi
                       created_at TIMESTAMPTZ DEFAULT now(),
                       updated_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON COLUMN users.suspended_until IS 'Digunakan oleh admin untuk menetapkan periode suspensi';


-- Tabel untuk menyimpan profil detail penjual
CREATE TABLE seller_profiles (
                                 id VARCHAR(36) PRIMARY KEY,
                                 user_id VARCHAR(36) NOT NULL UNIQUE,
                                 store_name VARCHAR(255) NOT NULL,
                                 store_description TEXT,
                                 address TEXT,
                                 latitude DECIMAL(10, 8) NOT NULL, -- Krusial untuk pencarian berbasis lokasi
                                 longitude DECIMAL(11, 8) NOT NULL, -- Krusial untuk pencarian berbasis lokasi
                                 average_rating DECIMAL(3, 2) DEFAULT 0.00, -- Dihitung dari seller_reviews
                                 balance DECIMAL(15, 2) DEFAULT 0.00,
                                 created_at TIMESTAMPTZ DEFAULT now(),
                                 updated_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON COLUMN seller_profiles.latitude IS 'Krusial untuk pencarian berbasis lokasi';
COMMENT ON COLUMN seller_profiles.longitude IS 'Krusial untuk pencarian berbasis lokasi';
COMMENT ON COLUMN seller_profiles.average_rating IS 'Dihitung dari seller_reviews';


-- Tabel untuk menu permanen yang dimiliki oleh penjual
CREATE TABLE menu_items (
                            id VARCHAR(36) PRIMARY KEY,
                            seller_profile_id VARCHAR(36) NOT NULL,
                            name VARCHAR(255) NOT NULL,
                            description TEXT,
                            image_url VARCHAR(255),
                            average_rating DECIMAL(3, 2) DEFAULT 0.00, -- Dihitung dari menu_item_reviews
                            created_at TIMESTAMPTZ DEFAULT now(),
                            updated_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON COLUMN menu_items.average_rating IS 'Dihitung dari menu_item_reviews';


-- Tabel untuk penawaran harian dari sebuah item menu
CREATE TABLE daily_listings (
                                id VARCHAR(36) PRIMARY KEY,
                                menu_item_id VARCHAR(36) NOT NULL,
                                original_price DECIMAL(10, 2) NOT NULL,
                                discounted_price DECIMAL(10, 2) NOT NULL,
                                quantity_available INT NOT NULL,
                                display_start_time TIMESTAMPTZ NOT NULL, -- Penjual mengatur kapan item mulai terlihat
                                display_end_time TIMESTAMPTZ NOT NULL, -- Penjual mengatur kapan item tidak lagi dijual
                                status listing_status DEFAULT 'available',
                                created_at TIMESTAMPTZ DEFAULT now()
);
COMMENT ON COLUMN daily_listings.display_start_time IS 'Penjual mengatur kapan item mulai terlihat';
COMMENT ON COLUMN daily_listings.display_end_time IS 'Penjual mengatur kapan item tidak lagi dijual';


-- Tabel untuk pesanan yang dibuat oleh pelanggan
CREATE TABLE orders (
                        id VARCHAR(36) PRIMARY KEY,
                        customer_id VARCHAR(36) NOT NULL,
                        seller_profile_id VARCHAR(36) NOT NULL,
                        total_amount DECIMAL(10, 2) NOT NULL,
                        order_status order_status NOT NULL,
                        created_at TIMESTAMPTZ DEFAULT now(),
                        updated_at TIMESTAMPTZ DEFAULT now()
);


-- Tabel perantara yang menghubungkan pesanan dengan item yang dibeli
CREATE TABLE order_items (
                             id VARCHAR(36) PRIMARY KEY,
                             order_id VARCHAR(36) NOT NULL,
                             listing_id VARCHAR(36) NOT NULL,
                             quantity_purchased INT NOT NULL,
                             price_per_item DECIMAL(10, 2) NOT NULL
);


-- Tabel untuk mencatat detail transaksi pembayaran
CREATE TABLE payments (
                          id VARCHAR(36) PRIMARY KEY,
                          order_id VARCHAR(36) NOT NULL,
                          midtrans_transaction_id VARCHAR(255) NOT NULL UNIQUE,
                          payment_type VARCHAR(50),
                          amount DECIMAL(10, 2) NOT NULL,
                          status payment_status NOT NULL,
                          transaction_time TIMESTAMPTZ NOT NULL,
                          created_at TIMESTAMPTZ DEFAULT now()
);


-- Tabel untuk ulasan yang diberikan pelanggan kepada penjual/toko
CREATE TABLE seller_reviews (
                                id VARCHAR(36) PRIMARY KEY,
                                customer_id VARCHAR(36) NOT NULL,
                                seller_profile_id VARCHAR(36) NOT NULL,
                                rating INT NOT NULL,
                                comment TEXT, -- Komentar bersifat opsional
                                created_at TIMESTAMPTZ DEFAULT now(),
                                CONSTRAINT unique_review_per_store UNIQUE (customer_id, seller_profile_id),
                                CONSTRAINT valid_rating_seller CHECK (rating >= 1 AND rating <= 5)
);
COMMENT ON COLUMN seller_reviews.rating IS 'Nilai dari 1 hingga 5';
COMMENT ON COLUMN seller_reviews.comment IS 'Komentar bersifat opsional';


-- Tabel untuk ulasan yang diberikan pelanggan pada item menu tertentu
CREATE TABLE menu_item_reviews (
                                   id VARCHAR(36) PRIMARY KEY,
                                   customer_id VARCHAR(36) NOT NULL,
                                   menu_item_id VARCHAR(36) NOT NULL,
                                   rating INT NOT NULL,
                                   comment TEXT, -- Komentar bersifat opsional
                                   created_at TIMESTAMPTZ DEFAULT now(),
                                   CONSTRAINT unique_review_per_menu UNIQUE (customer_id, menu_item_id),
                                   CONSTRAINT valid_rating_menu_item CHECK (rating >= 1 AND rating <= 5)
);
COMMENT ON COLUMN menu_item_reviews.rating IS 'Nilai dari 1 hingga 5';
COMMENT ON COLUMN menu_item_reviews.comment IS 'Komentar bersifat opsional';

-- Tabel untuk menyimpan keranjang belanja pelanggan
CREATE TABLE carts (
    id VARCHAR(36) PRIMARY KEY,
    customer_id VARCHAR(36) NOT NULL UNIQUE,
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

-- Tabel untuk menyimpan item di keranjang belanja pelanggan sebelum checkout
CREATE TABLE cart_items (
                            id VARCHAR(36) PRIMARY KEY,
                            cart_id VARCHAR(36) NOT NULL,
                            listing_id VARCHAR(36) NOT NULL, -- Merujuk ke penawaran harian yang ditambahkan
                            quantity INT NOT NULL CHECK (quantity > 0), -- Jumlah item yang ditambahkan
                            created_at TIMESTAMPTZ DEFAULT now(),
                            updated_at TIMESTAMPTZ DEFAULT now(), -- Diperbarui saat kuantitas diubah
    -- Constraint untuk memastikan seorang pelanggan hanya punya satu baris untuk satu jenis listing
                            CONSTRAINT unique_item_in_cart UNIQUE (cart_id, listing_id)
);
COMMENT ON COLUMN cart_items.quantity IS 'Jumlah item yang ditambahkan';
COMMENT ON CONSTRAINT unique_item_in_cart ON cart_items IS 'Memastikan seorang pelanggan hanya punya satu baris untuk satu jenis listing di keranjangnya.';

-- Tabel untuk permintaan penarikan dana oleh penjual
CREATE TABLE withdrawal_requests (
                                     id VARCHAR(36) PRIMARY KEY,
                                     seller_id VARCHAR(36) NOT NULL,
                                     amount DECIMAL(15, 2) NOT NULL,
                                     status withdrawal_status NOT NULL,
                                     request_date TIMESTAMPTZ DEFAULT now(),
                                     processed_date TIMESTAMPTZ,
                                     processed_by_id VARCHAR(36),
                                     proof_of_payment_url VARCHAR(255)
);

