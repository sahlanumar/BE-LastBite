package com.enigma.lastbite.service.impl;

import com.enigma.lastbite.constant.OrderStatus;
import com.enigma.lastbite.dto.request.MenuItemReviewCreateRequest;
import com.enigma.lastbite.dto.response.MenuItemReviewResponse;
import com.enigma.lastbite.entity.*;
import com.enigma.lastbite.exception.CustomException;
import com.enigma.lastbite.exception.ErrorCode;
import com.enigma.lastbite.mapper.MenuReviewMapper;
import com.enigma.lastbite.repository.MenuItemReviewRepository;
import com.enigma.lastbite.security.JwtUtils;
import com.enigma.lastbite.service.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockedStatic;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.List;
import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class MenuItemReviewServiceImplTest {

    @Mock private MenuItemReviewRepository menuItemReviewRepository;
    @Mock private JwtUtils jwtUtils;
    @Mock private UserService userService;
    @Mock private SellerService sellerService;
    @Mock private MenuItemService menuItemService;
    @Mock private OrderService orderService;

    @InjectMocks private MenuItemReviewServiceImpl menuItemReviewService;

    private User dummyUser;
    private MenuItem dummyMenuItem;
    private Order dummyOrder;
    private OrderItem dummyOrderItem;

    @BeforeEach
    void setUp() {
        dummyUser = User.builder().id("user-1").username("testuser").build();

        SellerProfile dummySeller = SellerProfile.builder()
                .id("seller-1")
                .build();

        dummyMenuItem = MenuItem.builder()
                .id("menu-1")
                .name("Burger")
                .sellerProfile(dummySeller) // <-- tambahkan ini
                .build();

        dummyOrderItem = OrderItem.builder()
                .id("oi-1")
                .menuItem(dummyMenuItem)
                .build();

        dummyOrder = Order.builder()
                .id("order-1")
                .customer(dummyUser)
                .orderStatus(OrderStatus.COMPLETED)
                .orderItems(List.of(dummyOrderItem))
                .build();
    }


    @Test
    void createReview_Success() {
        MenuItemReviewCreateRequest request = MenuItemReviewCreateRequest.builder()
                .orderId("order-1")
                .menuItemId("menu-1")
                .rating(5)
                .comment("Great!")
                .build();

        when(jwtUtils.getTokenFromHeader()).thenReturn("Bearer token");
        when(jwtUtils.getUsernameFromJwtToken("Bearer token")).thenReturn("testuser");
        when(userService.findByUsername("testuser")).thenReturn(Optional.of(dummyUser));
        when(orderService.findOrderByIdOrThrow("order-1")).thenReturn(dummyOrder);
        when(menuItemService.findById("menu-1")).thenReturn(dummyMenuItem);
        when(menuItemReviewRepository.existsByOrderIdAndMenuItemId("order-1", "menu-1")).thenReturn(false);
        when(menuItemReviewRepository.save(any(MenuItemReview.class))).thenAnswer(invocation -> invocation.getArgument(0));
        when(menuItemReviewRepository.findAllByMenuItemId("menu-1")).thenReturn(List.of());

        try (MockedStatic<MenuReviewMapper> mocked = mockStatic(MenuReviewMapper.class)) {
            MenuItemReview dummyReview = MenuItemReview.builder()
                    .order(dummyOrder)
                    .menuItem(dummyMenuItem)
                    .rating(5)
                    .comment("Great!")
                    .build();

            mocked.when(() -> MenuReviewMapper.toMenuItemReviewEntity(any(), any(), any())).thenReturn(dummyReview);
            mocked.when(() -> MenuReviewMapper.toMenuItemReviewResponse(any())).thenReturn(
                    MenuItemReviewResponse.builder().menuItemId("menu-1").build()
            );

            MenuItemReviewResponse response = menuItemReviewService.createReview(request);

            assertNotNull(response);
            assertEquals("menu-1", response.getMenuItemId());
        }
    }

    @Test
    void createReview_UserNotFound_ThrowsException() {
        MenuItemReviewCreateRequest request = MenuItemReviewCreateRequest.builder()
                .orderId("order-1")
                .menuItemId("menu-1")
                .build();

        when(jwtUtils.getTokenFromHeader()).thenReturn("Bearer token");
        when(jwtUtils.getUsernameFromJwtToken("Bearer token")).thenReturn("unknownuser");
        when(userService.findByUsername("unknownuser")).thenReturn(Optional.empty());

        CustomException exception = assertThrows(CustomException.class, () -> menuItemReviewService.createReview(request));
        assertEquals(ErrorCode.USER_NOT_FOUND, exception.getErrorCode());
    }

    @Test
    void createReview_MenuItemNotInOrder_ThrowsException() {
        MenuItemReviewCreateRequest request = MenuItemReviewCreateRequest.builder()
                .orderId("order-1")
                .menuItemId("not-in-order")
                .build();

        dummyOrder.setOrderItems(List.of()); // Kosongkan item

        when(jwtUtils.getTokenFromHeader()).thenReturn("Bearer token");
        when(jwtUtils.getUsernameFromJwtToken("Bearer token")).thenReturn("testuser");
        when(userService.findByUsername("testuser")).thenReturn(Optional.of(dummyUser));
        when(orderService.findOrderByIdOrThrow("order-1")).thenReturn(dummyOrder);
        when(menuItemService.findById("not-in-order")).thenReturn(MenuItem.builder().id("not-in-order").build());

        CustomException ex = assertThrows(CustomException.class, () -> menuItemReviewService.createReview(request));
        assertEquals(ErrorCode.MENU_ITEM_NOT_IN_ORDER, ex.getErrorCode());
    }
}
