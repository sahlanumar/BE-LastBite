    @Nested
    @DisplayName("Get Report Tests")
    class GetReportTests {

        @Test
        @DisplayName("getReport(): Sukses mendapatkan laporan tanpa filter tanggal")
        void getReport_WithoutDateFilter_Success() {
            try (MockedStatic<OrderMapper> mockedMapper = mockStatic(OrderMapper.class)) {
                // Given: Filter kosong
                ReportFilterRequest filter = new ReportFilterRequest();

                // Siapkan data yang akan dikembalikan oleh service dan repository
                long customerCount = 50L;
                long sellerCount = 10L;
                long successTx = 100L;
                BigDecimal successAmount = new BigDecimal("5000000");

                when(userService.countByRole(any())).thenReturn(customerCount);
                when(sellerService.countByStatus(any())).thenReturn(sellerCount);
                when(orderRepository.countByStatus(OrderStatus.COMPLETED)).thenReturn(successTx);
                when(orderRepository.sumTotalAmountByStatus(OrderStatus.COMPLETED)).thenReturn(successAmount);

                // Mock mapper untuk mengembalikan response final
                mockedMapper.when(() -> OrderMapper.toResponse(customerCount, sellerCount, successTx, successAmount))
                        .thenReturn(ReportResponse.builder()
                                .totalCustomer(customerCount)
                                .totalSeller(sellerCount)
                                .totalSuccessTx(successTx)
                                .totalSuccessAmount(successAmount)
                                .build());

                // When: Panggil metode getReport
                ReportResponse response = orderService.getReport(filter);

                // Then: Lakukan asersi
                assertNotNull(response);
                assertEquals(customerCount, response.getTotalCustomer());
                assertEquals(sellerCount, response.getTotalSeller());
                assertEquals(successTx, response.getTotalSuccessTx());
                assertEquals(successAmount, response.getTotalSuccessAmount());

                // Verifikasi bahwa metode repository TANPA tanggal yang dipanggil
                verify(orderRepository).countByStatus(OrderStatus.COMPLETED);
                verify(orderRepository).sumTotalAmountByStatus(OrderStatus.COMPLETED);
                // Verifikasi bahwa metode DENGAN tanggal TIDAK dipanggil
                verify(orderRepository, never()).countByStatusBetween(any(), any(), any());
            }
        }

        @Test
        @DisplayName("getReport(): Sukses mendapatkan laporan dengan filter rentang tanggal")
        void getReport_WithDateRangeFilter_Success() {
            try (MockedStatic<OrderMapper> mockedMapper = mockStatic(OrderMapper.class)) {
                // Given: Filter dengan rentang tanggal
                LocalDateTime start = LocalDateTime.now().minusDays(30);
                LocalDateTime end = LocalDateTime.now();
                ReportFilterRequest filter = ReportFilterRequest.builder().start(start).end(end).build();

                // Siapkan data dummy
                long successTx = 75L;
                BigDecimal successAmount = new BigDecimal("3000000");

                // Mock hanya metode repository DENGAN tanggal
                when(orderRepository.countByStatusBetween(OrderStatus.COMPLETED, start, end)).thenReturn(successTx);
                when(orderRepository.sumTotalAmountByStatusBetween(OrderStatus.COMPLETED, start, end)).thenReturn(successAmount);
                mockedMapper.when(() -> OrderMapper.toResponse(anyLong(), anyLong(), anyLong(), any()))
                        .thenReturn(new ReportResponse( ));


                // When
                orderService.getReport(filter);

                // Then
                // Verifikasi bahwa metode repository DENGAN rentang tanggal yang dipanggil
                verify(orderRepository).countByStatusBetween(OrderStatus.COMPLETED, start, end);
                verify(orderRepository).sumTotalAmountByStatusBetween(OrderStatus.COMPLETED, start, end);
                // Verifikasi bahwa metode TANPA tanggal TIDAK dipanggil
                verify(orderRepository, never()).countByStatus(any());
            }
        }
    }

