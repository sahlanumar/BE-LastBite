    @Nested
    @DisplayName("Verify and Complete Order Tests")
    class VerifyAndCompleteOrderTests {

        @BeforeEach
        void setupForCompletion() {
            // Siapkan order agar siap untuk diverifikasi
            dummyOrder.setOrderStatus(OrderStatus.READY_FOR_PICKUP);
            dummyOrder.setVerificationCode("123456");
        }

        @Test
        @DisplayName("verifyAndCompleteOrder(): Sukses menyelesaikan order dengan kode valid")
        void verifyAndCompleteOrder_Success() {
            try (MockedStatic<OrderMapper> mockedMapper = mockStatic(OrderMapper.class)) {
                // Given: Request dengan kode verifikasi yang benar
                VerifyOrderRequest request = VerifyOrderRequest.builder().verificationCode("123456").build();

                when(orderRepository.findById("order-1")).thenReturn(Optional.of(dummyOrder));
                when(orderRepository.save(any(Order.class))).thenReturn(dummyOrder);
                mockedMapper.when(() -> OrderMapper.toResponse(any(Order.class))).thenReturn(new OrderResponse());

                // Saldo awal seller adalah 0
                assertEquals(BigDecimal.ZERO, dummyOrder.getSellerProfile().getBalance());

                // When: Panggil metode verifikasi
                orderService.verifyAndCompleteOrder("order-1", request);

                // Then: Verifikasi status dan saldo seller
                ArgumentCaptor<Order> orderCaptor = ArgumentCaptor.forClass(Order.class);
                verify(orderRepository).save(orderCaptor.capture());
                Order completedOrder = orderCaptor.getValue();

                // Status harus COMPLETED
                assertEquals(OrderStatus.COMPLETED, completedOrder.getOrderStatus());
                // Saldo seller harus bertambah sesuai totalAmount order (30000)
                assertEquals(new BigDecimal("30000"), completedOrder.getSellerProfile().getBalance());
            }
        }

        @Test
        @DisplayName("verifyAndCompleteOrder(): Gagal karena kode verifikasi salah")
        void verifyAndCompleteOrder_InvalidCode_ThrowsException() {
            // Given: Request dengan kode verifikasi yang SALAH
            VerifyOrderRequest request = VerifyOrderRequest.builder().verificationCode("654321").build();
            when(orderRepository.findById("order-1")).thenReturn(Optional.of(dummyOrder));

            // When & Then: Harapkan exception
            CustomException exception = assertThrows(CustomException.class, () -> {
                orderService.verifyAndCompleteOrder("order-1", request);
            });

            assertEquals(ErrorCode.INVALID_VERIFICATION_CODE, exception.getErrorCode());
            verify(orderRepository, never()).save(any());
        }

        @Test
        @DisplayName("verifyAndCompleteOrder(): Gagal karena order belum siap diambil")
        void verifyAndCompleteOrder_OrderNotReady_ThrowsException() {
            // Given: Status order bukan READY_FOR_PICKUP
            dummyOrder.setOrderStatus(OrderStatus.PREPARING);
            VerifyOrderRequest request = VerifyOrderRequest.builder().verificationCode("123456").build();
            when(orderRepository.findById("order-1")).thenReturn(Optional.of(dummyOrder));

            // When & Then: Harapkan exception
            CustomException exception = assertThrows(CustomException.class, () -> {
                orderService.verifyAndCompleteOrder("order-1", request);
            });

            assertEquals(ErrorCode.ORDER_NOT_READY_FOR_PICKUP, exception.getErrorCode());
            verify(orderRepository, never()).save(any());
        }
    }

