    class GetAllOrdersTests {

        @Test
        @DisplayName("getAllOrders(): Sukses mendapatkan daftar order dengan paginasi")
        void getAllOrders_Success() {
            try (MockedStatic<OrderMapper> mockedMapper = mockStatic(OrderMapper.class)) {
                // Given: Filter dan paginasi
                OrderFilterRequest filter = new OrderFilterRequest();
                int page = 0;
                int size = 10;
                // Siapkan data dummy Page yang akan dikembalikan oleh repository
                Page<Order> dummyPage = new PageImpl<>(List.of(dummyOrder));

                when(orderRepository.findAll(any(org.springframework.data.jpa.domain.Specification.class), any(Pageable.class)))
                        .thenReturn(dummyPage);

                // Mock mapper untuk konversi dari Order ke OrderResponse
                mockedMapper.when(() -> OrderMapper.toResponse(any(Order.class)))
                        .thenReturn(OrderResponse.builder().orderId("order-1").build());

                // When: Panggil metode getAllOrders
                Page<OrderResponse> resultPage = orderService.getAllOrders(filter, page, size, "createdAt", "desc");

                // Then: Lakukan asersi pada hasil paginasi
                assertNotNull(resultPage);
                assertEquals(1, resultPage.getTotalElements());
                assertEquals("order-1", resultPage.getContent().get(0).getOrderId());

                // Verifikasi bahwa repository dipanggil dengan benar
                ArgumentCaptor<Pageable> pageableCaptor = ArgumentCaptor.forClass(Pageable.class);
                verify(orderRepository).findAll(any(org.springframework.data.jpa.domain.Specification.class), pageableCaptor.capture());
                Pageable capturedPageable = pageableCaptor.getValue();

                assertEquals(page, capturedPageable.getPageNumber());
                assertEquals(size, capturedPageable.getPageSize());
                assertTrue(capturedPageable.getSort().isSorted());
                assertEquals(Sort.Direction.DESC, capturedPageable.getSort().getOrderFor("createdAt").getDirection());
            }
        }
