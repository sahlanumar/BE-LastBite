                when(paymentService.createPayment(any(PaymentRequest.class))).thenReturn(paymentResponse);

                // Mock mapper
                mockedMapper.when(() -> OrderMapper.toOrderItemEntity(any(CartItem.class))).thenReturn(new OrderItem());
                mockedMapper.when(() -> OrderMapper.toOrderEntity(any(), any(), any(), any(), any())).thenReturn(dummyOrder);
