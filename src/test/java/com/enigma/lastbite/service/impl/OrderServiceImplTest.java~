    // Mengelompokkan test untuk metode createOrder
    @Nested
    @DisplayName("Create Order Tests")
    class CreateOrderTests {

        @Test
        @DisplayName("createOrder(): Sukses membuat order baru")
        void createOrder_Success() {
            try (MockedStatic<OrderMapper> mockedMapper = mockStatic(OrderMapper.class)) {
                // Given: Siapkan request yang valid
                OrderItemRequest itemRequest = OrderItemRequest.builder()
                        .menuItemId("menu-item-1")
                        .quantity(2)
                        .build();
                OrderRequest orderRequest = OrderRequest.builder()
                        .orderItems(Collections.singletonList(itemRequest))
                        .build();

                // Setup mock untuk dependency
                setupUserAuthentication("testcustomer");
                when(menuItemService.findById("menu-item-1")).thenReturn(dummyMenuItem);
                // `saveAndFlush` akan mengembalikan objek yang sama dengan yang disimpan
                when(orderRepository.saveAndFlush(any(Order.class))).thenAnswer(invocation -> invocation.getArgument(0));

                // Siapkan response dari payment service
                PaymentResponse paymentResponse = PaymentResponse.builder()
                        .redirectUrl("http://example.com/payment")
                        .build();
                when(paymentService.createPayment(any(PaymentRequest.class))).thenReturn(paymentResponse);

                // Mock semua metode statis dari OrderMapper
                mockedMapper.when(() -> OrderMapper.toOrderItemEntity(any(), any())).thenReturn(new OrderItem());
                mockedMapper.when(() -> OrderMapper.toOrderEntity(any(), any(), any(), any(), any())).thenReturn(dummyOrder);
                mockedMapper.when(() -> OrderMapper.toResponse(any(Order.class), any(PaymentResponse.class)))
                        .thenReturn(OrderResponse.builder().orderId("order-1").urlMidtrans("http://example.com/payment").build());

                // When: Panggil metode yang akan di-test
                OrderResponse response = orderService.createOrder(orderRequest);

                // Then: Lakukan verifikasi dan asersi
                assertNotNull(response);
                assertEquals("order-1", response.getOrderId());
                assertEquals("http://example.com/payment", response.getUrlMidtrans());

                // Verifikasi bahwa stok item dikurangi
                ArgumentCaptor<MenuItem> menuItemCaptor = ArgumentCaptor.forClass(MenuItem.class);
                verify(menuItemService).save(menuItemCaptor.capture());
                assertEquals(18, menuItemCaptor.getValue().getQuantityAvailable()); // Stok awal 20 - 2 = 18

                // Verifikasi bahwa order disimpan dua kali (sebelum dan sesudah ada URL payment)
                verify(orderRepository, times(2)).saveAndFlush(any(Order.class));
                // Verifikasi bahwa payment dibuat
                verify(paymentService).createPayment(any(PaymentRequest.class));
            }
        }

        @Test
        @DisplayName("createOrder(): Gagal karena stok tidak cukup (OUT_OF_STOCK)")
        void createOrder_OutOfStock_ThrowsException() {
            // Given: Stok hanya 5, tapi request 10
            dummyMenuItem.setQuantityAvailable(5);
            OrderItemRequest itemRequest = OrderItemRequest.builder().menuItemId("menu-item-1").quantity(10).build();
            OrderRequest orderRequest = OrderRequest.builder().orderItems(Collections.singletonList(itemRequest)).build();

            setupUserAuthentication("testcustomer");
            when(menuItemService.findById("menu-item-1")).thenReturn(dummyMenuItem);

            // When & Then: Harapkan CustomException dengan ErrorCode yang sesuai
            CustomException exception = assertThrows(CustomException.class, () -> {
                orderService.createOrder(orderRequest);
            });

            assertEquals(ErrorCode.OUT_OF_STOCK, exception.getErrorCode());
            // Pastikan tidak ada order yang disimpan
            verify(orderRepository, never()).saveAndFlush(any());
        }

        @Test
        @DisplayName("createOrder(): Gagal karena item dari seller yang berbeda (INVALID_MENU_ITEM)")
        void createOrder_DifferentSellers_ThrowsException() {
            // Given: Siapkan dua item dari dua seller yang berbeda
            SellerProfile anotherSeller = SellerProfile.builder().id("seller-2").build();
            MenuItem anotherMenuItem = MenuItem.builder().id("menu-item-2").sellerProfile(anotherSeller).quantityAvailable(10).discountedPrice(BigDecimal.TEN).displayEndTime(LocalDateTime.now().plusHours(1)).build();

            OrderRequest orderRequest = OrderRequest.builder()
                    .orderItems(List.of(
                            OrderItemRequest.builder().menuItemId("menu-item-1").quantity(1).build(),
                            OrderItemRequest.builder().menuItemId("menu-item-2").quantity(1).build()
                    ))
                    .build();

            setupUserAuthentication("testcustomer");
            when(menuItemService.findById("menu-item-1")).thenReturn(dummyMenuItem);
            when(menuItemService.findById("menu-item-2")).thenReturn(anotherMenuItem);

            // When & Then
            CustomException exception = assertThrows(CustomException.class, () -> {
                orderService.createOrder(orderRequest);
            });

            assertEquals(ErrorCode.INVALID_MENU_ITEM, exception.getErrorCode());
        }
    }

