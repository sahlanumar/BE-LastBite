version: '3.9'

networks:
  lastbite-network:
    driver: bridge

services:
  database:
    image: postgres:15
    container_name: lastbite-postgres
    networks:
      - lastbite-network
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "${DB_PORT}:5432"
    volumes:
      - lastbite_postgres_data:/var/lib/postgresql/data

  app:
    build: .
    image: msahlanumar/lastbite-app:latest
    container_name: lastbite-app
    networks:
      - lastbite-network
    depends_on:
      - database
    environment:
      DB_URL: jdbc:postgresql://database:5432/${POSTGRES_DB}
      DB_USERNAME: ${DB_USERNAME}
      DB_PASSWORD: ${DB_PASSWORD}

      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRATION: ${JWT_EXPIRATION}
      REFRESH_TOKEN_EXPIRATION: ${REFRESH_TOKEN_EXPIRATION}

      SUPER_ADMIN_SECRET: ${SUPER_ADMIN_SECRET}

      MIDTRANS_SERVER_KEY: ${MIDTRANS_SERVER_KEY}
      MIDTRANS_CLIENT_KEY: ${MIDTRANS_CLIENT_KEY}

      CLOUDINARY_CLOUD_NAME: ${CLOUDINARY_CLOUD_NAME}
      CLOUDINARY_API_KEY: ${CLOUDINARY_API_KEY}
      CLOUDINARY_API_SECRET: ${CLOUDINARY_API_SECRET}
    ports:
      - "${APP_PORT}:8080"

volumes:
  lastbite_postgres_data:
